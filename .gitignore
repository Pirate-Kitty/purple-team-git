# Backstop only — the primary control is that real evidence never lives in
# this repo (see REDACTION.md). These patterns catch accidental drops.
*.pem
*.key
*.p12
*.pfx
.env
.env.*
credentials*
*_history
*.pcap
*.evtx
*.log

# Local-only, machine-specific config — never committed. Each installation
# creates its own; see .mcp.json.example and README.md.
.mcp.json
.claude/settings.local.json
config/data-sources.local.yaml
